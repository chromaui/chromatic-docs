---
import { lightboxStyles } from './styles';

/*
 * No markup here on purpose: the rehype-zoomable-images plugin adds
 * `class="zoomable"` to static Markdown images at build time. This component,
 * rendered once from BaseLayout, ships the styles and the script that opens
 * those images in a native <dialog> lightbox. Behavior lives in
 * `image-lightbox.ts` so stories can exercise the same code.
 */
---

<style is:global set:html={lightboxStyles}></style>

<script>
  import { initImageLightbox } from './image-lightbox';
  initImageLightbox();
</script>
